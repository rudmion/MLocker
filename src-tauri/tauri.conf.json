{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MLocker",
  "version": "1.0.9",
  "identifier": "com.rudya.mlocker",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MLocker",
        "width": 800,
        "height": 570,
        "minWidth": 900,
        "minHeight": 570,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFQjQ2MTk3MUVEMjY3RTMKUldUalo5SWVsMkcwL240SDdBR0tTa0JYTURsdzFGVVZseFBtcWljQUROWmdiaDBzSlVEMHAwVUsK",
      "endpoints": [
        "https://github.com/rudmion/MLocker/releases/latest/download/latest.json"
      ]
    }
  }
}
